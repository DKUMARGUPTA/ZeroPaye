# ZeroPaye — Environment Variables Example
# Copy to .env and adjust. In production, never commit .env.

# Database (SQLite). Use file: path for local dev.
# For production, consider PostgreSQL (update prisma/schema.prisma provider).
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# Node environment: "development" (shows demo OTPs) or "production" (hides them)
NODE_ENV="development"

# ZeroPaye Webhook Secret — auto-generated on first boot via crypto.randomBytes
# Only set this if you want to override the auto-generated one.
# ZEROPAYE_WEBHOOK_SECRET=

# ZeroPaye Observer Device Signing Key — auto-generated on first boot
# The Android observer keeps the plaintext; the server stores only SHA-256 hash.
# DEMO_DEVICE_SIGNING_KEY=
