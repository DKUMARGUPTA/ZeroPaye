# ZeroPaye — Environment Variables Example
# Copy to .env and adjust. In production, never commit .env.

# Database (SQLite). Use a relative path for portability.
# For production, consider PostgreSQL (update prisma/schema.prisma provider).
DATABASE_URL="file:../db/custom.db"

# Node environment: "development" (shows demo OTPs) or "production" (hides them)
NODE_ENV="development"

# ZeroPaye Webhook Secret — OPTIONAL.
# If set, overrides the auto-generated secret stored in the DB.
# Use this when you need to share the secret with your backend (which verifies webhooks).
# If unset, the secret is auto-generated on first boot via crypto.randomBytes
# and stored in the merchants table. Read it via /api/zeropaye/bootstrap (dev) or
# the admin API (prod).
# ZEROPAYE_WEBHOOK_SECRET=""

# ZeroPaye Observer Device Signing Key — OPTIONAL.
# If set, overrides the auto-generated demo signing key stored in .demo-observer-key.
# The Android Observer keeps the plaintext; the server stores only the SHA-256 hash.
# DEMO_DEVICE_SIGNING_KEY=""

# Port (optional, defaults to 3000)
# PORT=3000

# Logging level (optional): debug | info | warn | error (default: info)
# LOG_LEVEL=info

# ============================================================
# OTP Delivery Provider (v3.2)
# ============================================================
# Choose how OTPs are delivered to customers.
# Default: console (logs to server console — dev only)
# Options: console | whatsapp | sms | email

OTP_PROVIDER="console"

# --- WhatsApp Business API ---
# Get credentials from Meta Business Suite:
# https://business.facebook.com/settings/whatsapp-business-api
# Create a template message named "zeropaye_otp" with body: "Your ZeroPaye verification code is {{1}}"
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_ID=""

# --- SMS Gateway (MSG91 / Twilio / generic) ---
# MSG91: https://msg91.com (authkey = SMS_API_KEY)
# Twilio: adjust SMS_API_URL format
# SMS_API_URL="https://api.msg91.com/api/v5/otp"
# SMS_API_KEY=""
# SMS_SENDER_ID="ZEROPY"

# --- Email OTP (SMTP) ---
# Requires customer email (not just mobile)
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# OTP_FROM_EMAIL="otp@yourdomain.com"

# ============================================================
# Demo Mode (Vercel / public demo deployment)
# ============================================================
# When DEMO_ADMIN_KEY is set, the demo account is LOCKED:
#   - Bootstrap endpoint returns this key even in production
#   - PATCH /admin/merchant rejects ALL changes (403)
#   - Demo routes (simulate-payment) work even in production
#   - No database required (uses mock merchant data)
#
# Set these on Vercel for the public demo:
#   DEMO_ADMIN_KEY=zp_demo_admin_locked_key_change_me
#   DEMO_PUBLIC_KEY=zp_demo_public_key_locked_001
#   DEMO_VPA=zeropaye.demo@upi
#   DEMO_WEBHOOK_SECRET=demo_webhook_secret_locked
#
# ⚠️ This key is PUBLIC (visible to anyone). It only works for demo
#    endpoints. Real merchant data is never accessible.

DEMO_ADMIN_KEY=""
DEMO_PUBLIC_KEY="zp_demo_public_key_locked_001"
DEMO_VPA="zeropaye.demo@upi"
DEMO_WEBHOOK_SECRET="demo_webhook_secret_locked"
